def load_keys():
    """uzunyx-keys is a program, not a module, and has what the shortcuts page needs."""
    loader = importlib.machinery.SourceFileLoader("uzunyx_keys", "/usr/bin/uzunyx-keys")
    spec = importlib.util.spec_from_loader("uzunyx_keys", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    # It sets its own name on load, and KWin takes the window's icon from this one.
    GLib.set_prgname("org.uzunyx.welcome")
    return module


def label(text, css=None, wrap=False):
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_line_wrap(wrap)
    if css:
        widget.get_style_context().add_class(css)
    return widget


def name_image(edition, width):
