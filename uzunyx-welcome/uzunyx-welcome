class Spinner(Gtk.DrawingArea):
    """A ring that turns. Gtk.Spinner only comes small, and its size in CSS stops it turning."""

    SIZE = 56
    WIDTH = 5
    TURN_SECONDS = 1.0

    def __init__(self):
        super().__init__(halign=Gtk.Align.CENTER)
        self.set_size_request(self.SIZE, self.SIZE)
        self.connect("draw", self.on_draw)
        self.tick = None

    def start(self):
        if self.tick is None:
            self.tick = self.add_tick_callback(lambda *_a: self.queue_draw() or GLib.SOURCE_CONTINUE)

    def stop(self):
        if self.tick is not None:
            self.remove_tick_callback(self.tick)
            self.tick = None

    def on_draw(self, _widget, cr):
        context = self.get_style_context()
        found, accent = context.lookup_color("theme_selected_bg_color")
        radius = (self.SIZE - self.WIDTH) / 2
        cr.set_line_width(self.WIDTH)
        cr.set_source_rgba(1, 1, 1, 0.15)
        cr.arc(self.SIZE / 2, self.SIZE / 2, radius, 0, 2 * math.pi)
        cr.stroke()
        if found:
            cr.set_source_rgba(accent.red, accent.green, accent.blue, 1)
        else:
            cr.set_source_rgba(1, 1, 1, 1)
        start = (time.monotonic() / self.TURN_SECONDS % 1) * 2 * math.pi
        cr.set_line_cap(1)  # round
        cr.arc(self.SIZE / 2, self.SIZE / 2, radius, start, start + math.pi / 2)
        cr.stroke()
        return False


class Welcome(Gtk.Application):
    def __init__(self, first_page, first_session=False):
        super().__init__(application_id="org.uzunyx.welcome")
        self.first_page = first_page
        self.first_session = first_session
        self.window = None
        self.edition = current_edition()
        self.names = []
        self.applying = False
        self.desktop_running = False
        self.desktop_wanted = None
        self.system_waiting = False
        self.system_skipped = None

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.window = Gtk.ApplicationWindow(application=self, title="Bienvenida a Uzunyx")
        self.window.set_icon_name("uzunyx-akane")
        self.window.set_default_size(980, 640)
        self.window.connect("delete-event", lambda *_a: self.applying)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.pages = [self.greeting_page(), self.keyboard_page(), keys_page(self.names), search_page(self.names),
                      control_center_page(self.names)]
        for index, page in enumerate(self.pages):
            self.stack.add_named(page, str(index))

        self.dots = Gtk.Label()
        self.back = Gtk.Button(label="Atrás")
        self.back.connect("clicked", lambda _b: self.go(self.index - 1))
        self.forward = Gtk.Button()
        self.forward.get_style_context().add_class("suggested-action")
        self.forward.connect("clicked", self.on_forward)
        footer = Gtk.Box(spacing=8)
        footer.pack_start(self.dots, False, False, 0)
        footer.pack_end(self.forward, False, False, 0)
        footer.pack_end(self.back, False, False, 0)

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, border_width=28)
        self.content.pack_start(self.stack, True, True, 0)
        self.content.pack_start(footer, False, False, 0)
        overlay = Gtk.Overlay()
        overlay.add(self.content)
        overlay.add_overlay(self.applying_view())
        self.window.add(overlay)
        self.window.show_all()
        self.cover.hide()
        self.show_edition()
        self.go(self.first_page)

    def greeting_page(self):
        page = Gtk.Box(spacing=28)
        page.pack_start(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(
            f"{SHARE}/akane-sora.png", 390, 520, True)), False, False, 0)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        name = Gtk.Image(halign=Gtk.Align.START)
        self.names.append((name, 300))
        side.pack_start(name, False, False, 0)
        side.pack_start(label("¡Hola, qué bueno verte!", "title"), False, False, 0)
        side.pack_start(label("Somos Akane y Sora, y te damos la bienvenida a tu nuevo escritorio. En un ratito te "
                              "mostramos lo básico para que te sientas como en casa.", wrap=True), False, False, 0)
        side.pack_start(label("Primero, ¿con cuál de las dos te quedás?", "ask"), False, False, 6)

        cards = Gtk.Box(spacing=12, homogeneous=True)
        first = None
        for edition, package, title, tone in EDITIONS:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            try:
                preview = GdkPixbuf.Pixbuf.new_from_file_at_scale(PREVIEWS.format(package), 240, 150, True)
                card.pack_start(Gtk.Image.new_from_pixbuf(preview), False, False, 0)
            except GLib.Error:
                pass
            card.pack_start(label(f"{title} · {tone}", "heading"), False, False, 0)
            button = Gtk.RadioButton.new_from_widget(first)
            first = first or button
            button.set_mode(False)
            button.get_style_context().add_class("edition")
            button.add(card)
            button.set_active(edition == self.edition)
            button.connect("toggled", self.on_card, edition)
            cards.pack_start(button, True, True, 0)
        side.pack_start(cards, False, False, 0)
        self.note = label("", "subtitle", wrap=True)
        side.pack_start(self.note, False, False, 0)
        page.pack_start(side, True, True, 0)
        return page

    def keyboard_page(self):
        box = page_box("Tu teclado", "¿Tu teclado tiene teclado numérico? Así la píldora del panel sabe qué teclas "
                       "vigilar y avisa en rojo si quedan mal puestas.", self.names)
        cards = Gtk.Box(spacing=22, homogeneous=True)
        current = has_numpad_option()
        first = None
        for numpad, title, text, keys in KEYBOARDS:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, valign=Gtk.Align.CENTER)
            card.pack_start(KeyboardDrawing(numpad), False, False, 8)
            heading = label(title, "heading")
            heading.set_xalign(0.5)
            card.pack_start(heading, False, False, 0)
            note = Gtk.Label(label=text, justify=Gtk.Justification.CENTER)
            note.get_style_context().add_class("subtitle")
            card.pack_start(note, False, False, 0)
            pill = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
            pill.pack_start(label("En el panel:", "subtitle"), False, False, 0)
            pill.pack_start(LockPill(keys), False, False, 0)
            card.pack_start(pill, False, False, 0)
            button = Gtk.RadioButton.new_from_widget(first)
            first = first or button
            button.set_mode(False)
            button.get_style_context().add_class("keyboard")
            button.add(card)
            button.set_active(numpad == current)
            button.connect("toggled", self.on_keyboard, numpad)
            cards.pack_start(button, True, True, 0)
        box.pack_start(cards, True, True, 0)
        return box

    def on_keyboard(self, button, numpad):
        if button.get_active():
            set_numpad_option(numpad)

    def applying_view(self):
        self.cover = Gtk.EventBox()
        self.cover.get_style_context().add_class("applying")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, halign=Gtk.Align.CENTER,
                      valign=Gtk.Align.CENTER)
        self.cover_name = Gtk.Image()
        self.spinner = Spinner()
        self.cover_title = Gtk.Label()
        self.cover_title.get_style_context().add_class("title")
        text = Gtk.Label(label="Estamos cambiando el escritorio, la pantalla de inicio de sesión y la de arranque.\n"
                               "Puede tardar un minuto; enseguida seguimos.", justify=Gtk.Justification.CENTER)
        for widget in (self.cover_name, self.spinner, self.cover_title, text):
            box.pack_start(widget, False, False, 0)
        self.cover.add(box)
        return self.cover

    def show_edition(self):
        for image, width in self.names:
            image.set_from_pixbuf(name_image(self.edition, width))
        self.cover_name.set_from_pixbuf(name_image(self.edition, 290))
        title = dict((e[0], e[2]) for e in EDITIONS)[self.edition]
        self.cover_title.set_text(f"Aplicando {title}…")
        text = "Se aplica a todo: escritorio, inicio de sesión y arranque."
        if system_parts(self.edition):
            text += " Te vamos a pedir tu contraseña al seguir."
        self.note.set_text(text)

    def on_card(self, button, edition):
        if not button.get_active():
            return
        self.edition = edition
        self.show_edition()
        self.apply_desktop()
        # Only now: reopened later from the menu, it must not replace a picture they chose.
        if self.first_session:
            set_avatar(edition)

    def apply_desktop(self):
        """Right away, so the choice can be seen; one at a time, the last click wins."""
        if self.desktop_running:
            self.desktop_wanted = self.edition
            return
        self.desktop_running = True
        self.desktop_wanted = None
        process = Gio.Subprocess.new(["uzunyx-edition", "set", self.edition], Gio.SubprocessFlags.NONE)
        process.wait_async(None, self.on_desktop_done)

    def on_desktop_done(self, process, result):
        process.wait_finish(result)
        self.desktop_running = False
        if self.desktop_wanted:
            self.apply_desktop()
        elif self.system_waiting:
            self.apply_system()

    def apply_system(self):
        self.system_waiting = False
        arguments = ["uzunyx-edition", "set", self.edition] + ONLY_SYSTEM + system_parts(self.edition)
        process = Gio.Subprocess.new(arguments, Gio.SubprocessFlags.NONE)
        process.wait_async(None, self.on_system_done)

    def on_system_done(self, process, result):
        process.wait_finish(result)
        self.show_applying(False)
        if process.get_successful():
            self.show_edition()
            self.go(self.index + 1)
        else:
            self.system_skipped = self.edition
            self.note.set_text("El escritorio ya cambió, pero la pantalla de inicio de sesión y la de arranque no: "
                               "se canceló o tu usuario no tiene permiso. Podés cambiarlas después en el módulo "
                               "«Uzunyx».")

    def show_applying(self, applying):
        self.applying = applying
        self.content.set_sensitive(not applying)
        self.cover.set_visible(applying)
        if applying:
            self.spinner.start()
        else:
            self.spinner.stop()

    def go(self, index):
        self.index = index
        self.stack.set_visible_child_name(str(index))
        self.dots.set_text(" ".join("●" if i == index else "○" for i in range(len(self.pages))))
        self.back.set_sensitive(index > 0)
        self.forward.set_label("Empezar" if index == len(self.pages) - 1 else "Siguiente")

    def on_forward(self, _button):
        if self.index == len(self.pages) - 1:
            self.window.destroy()
        elif self.index == 0 and self.system_skipped != self.edition and system_parts(self.edition):
            self.show_applying(True)
            if self.desktop_running:
                self.system_waiting = True
            else:
                self.apply_system()
        else:
            self.go(self.index + 1)


def should_open_first_login():
    if not os.path.exists(MARK):
        return False
    with open("/proc/cmdline", encoding="utf-8") as cmdline:
        return "boot=live" not in cmdline.read().split()


def main():
    args = sys.argv[1:]
    first_session = FIRST_SESSION in args
    if "--first-login" in args:
        if not should_open_first_login():
            return
        os.remove(MARK)
        # At a first login that runs at the same time as this and the window would come
        # out light. GTK reads its settings once: start over when they are there.
        for _ in range(40):
            if os.path.exists(GTK_READY):
                break
            time.sleep(0.5)
        os.execv(sys.argv[0], [sys.argv[0], FIRST_SESSION])
    first_page = int(args[args.index("--page") + 1]) if "--page" in args else 0
    GLib.set_prgname("org.uzunyx.welcome")
    Welcome(first_page, first_session).run([])


if __name__ == "__main__":
    main()
