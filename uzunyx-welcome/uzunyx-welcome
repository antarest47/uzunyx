    row = Gtk.Box(spacing=32, homogeneous=True)
    for title, note, rows in keys.SECTIONS:
        if title in KEY_SECTIONS:
            # "This window" there means the list of shortcuts.
            rows = [("Todos los atajos", *row[1:]) if row[0] == "Esta ventana" else row for row in rows]
            section = keys.section_box(bus, title, note, rows)
