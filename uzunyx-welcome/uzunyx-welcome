def page_box(title, subtitle, names):
    """A page with the styled name next to its title; names keeps the image to recolour it."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
    head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    top = Gtk.Box(spacing=14)
    name = Gtk.Image()
    names.append((name, 150))
    top.pack_start(name, False, False, 0)
