#!/bin/sh
# Switches the user's GTK theme from Breeze to Breeze-Uzunyx once, at login,
# and gives libadwaita apps the Uzunyx window buttons.
#
# A Plasma global theme cannot set the GTK theme, and kde-gtk-config sets
# Breeze for new users. Only Breeze or no theme is replaced, and only once:
# after that the user's choice in System Settings is kept.
#
# The name must start with "Breeze": Electron picks its title bar button
# style (Breeze or GNOME spacing) by the GTK theme name.

config="${XDG_CONFIG_HOME:-$HOME/.config}"

# Window buttons of libadwaita apps, which ignore GTK themes: a CSS file of
# uzunyx-buttons in the user's GTK 4 config, copied at every login (so new
# versions arrive) and imported from gtk.css once (kde-gtk-config keeps the
# rest of that file when it adds its colors.css). Flatpak apps get that folder
# read-only, also once, when flatpak is there.
css=/usr/share/uzunyx-buttons/uzunyx-windowcontrols.css
if [ -r "$css" ]; then
    mkdir -p "$config/gtk-4.0" "$config/uzunyx"
    cmp -s "$css" "$config/gtk-4.0/uzunyx-windowcontrols.css" ||
        cp "$css" "$config/gtk-4.0/uzunyx-windowcontrols.css"
    if [ ! -e "$config/uzunyx/gtk4-windowcontrols" ]; then
        grep -qs "uzunyx-windowcontrols.css" "$config/gtk-4.0/gtk.css" ||
            printf "\n@import 'uzunyx-windowcontrols.css';\n" >> "$config/gtk-4.0/gtk.css"
        touch "$config/uzunyx/gtk4-windowcontrols"
    fi
    if [ ! -e "$config/uzunyx/flatpak-gtk4" ] && command -v flatpak >/dev/null 2>&1; then
        flatpak override --user --filesystem=xdg-config/gtk-4.0:ro &&
            touch "$config/uzunyx/flatpak-gtk4"
    fi
fi

marker="$config/uzunyx/gtk-theme-set"
[ -e "$marker" ] && exit 0

current=$(sed -n 's/^gtk-theme-name=//p' "$config/gtk-3.0/settings.ini" 2>/dev/null)
case "$current" in
    ""|Breeze)
        # kded may still be starting: try for a while; on failure, retry
        # at the next login.
        i=0
        until busctl --user call org.kde.kded6 /GtkConfig org.kde.GtkConfig setGtkTheme s Breeze-Uzunyx >/dev/null 2>&1; do
            i=$((i + 1))
            [ $i -ge 15 ] && exit 1
            sleep 2
        done
        ;;
esac

mkdir -p "$(dirname "$marker")" && touch "$marker"
