#!/bin/bash
# Instala paquetes .deb locales con «sudo apt install ./paquete.deb» en una
# terminal, para ver lo que hace apt y escribir la contraseña.
#
#   uzunyx-debinstall archivo.deb [...]   abre una terminal y los instala
#   uzunyx-debinstall --run archivo.deb   lo que corre dentro de la terminal
#
# Copyright (C) 2026 emi
# SPDX-License-Identifier: GPL-3.0-or-later

set -u

if [ "${1:-}" != "--run" ]; then
    [ $# -gt 0 ] || { echo "Uso: uzunyx-debinstall archivo.deb [...]" >&2; exit 2; }
    self=$(readlink -f "$0")
    if command -v konsole >/dev/null; then
        exec konsole --separate -p tabtitle="Instalar paquetes" -e "$self" --run "$@"
    elif command -v x-terminal-emulator >/dev/null; then
        exec x-terminal-emulator -e "$self" --run "$@"
    else
        echo "No hay ninguna terminal para mostrar la instalación." >&2
        exit 1
    fi
fi
shift

bold=$'\e[1m'; green=$'\e[32m'; red=$'\e[31m'; reset=$'\e[0m'

finish() {
    echo
    read -rsn1 -p "Pulsa cualquier tecla para cerrar…"
    echo
    exit "$1"
}

debs=()
for f in "$@"; do
    case "$f" in file://*) f=${f#file://}; f=$(printf '%b' "${f//%/\\x}") ;; esac
    if [ ! -f "$f" ]; then
        echo "${red}No existe: $f${reset}"
        finish 1
    fi
    path=$(readlink -f "$f")
    if ! info=$(dpkg-deb -W --showformat='${Package} ${Version} (${Architecture})\n${Description}\n' "$path" 2>&1); then
        echo "${red}No es un paquete .deb válido: $f${reset}"
        echo "$info"
        finish 1
    fi
    echo "${bold}$(head -1 <<<"$info")${reset}"
    sed -n '2p' <<<"$info" | sed 's/^/  /'
    debs+=("$path")
done
echo

# apt solo trata el argumento como archivo si empieza por / o ./
echo "${bold}\$ sudo apt install ${debs[*]}${reset}"
if sudo apt install "${debs[@]}"; then
    echo
    echo "${green}${bold}Listo: instalado.${reset}"
    finish 0
else
    status=$?
    echo
    echo "${red}${bold}La instalación no terminó (código $status).${reset}"
    finish "$status"
fi
