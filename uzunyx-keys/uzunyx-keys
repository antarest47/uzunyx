#!/usr/bin/python3
"""Shows the desktop's shortcuts, with the keys they have right now.

The keys come from kglobalaccel, so a change in System Settings shows here too;
an action without keys, or from a package that isn't installed, is left out.
Called again, or with Esc, it closes.
"""

import os
import subprocess

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

