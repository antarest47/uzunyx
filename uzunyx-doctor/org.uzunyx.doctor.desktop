[Desktop Entry]
Type=Application
Name=Uzunyx Doctor
GenericName=Update and check the system
GenericName[es]=Actualizar y comprobar el sistema
Comment=Updates the system and checks that Uzunyx still works
Comment[es]=Actualiza el sistema y comprueba que Uzunyx siga funcionando
Exec=konsole -e env UZUNYX_DOCTOR_WINDOW=1 /usr/bin/uzunyx-doctor
Icon=system-software-update
Categories=System;
Keywords=update;upgrade;actualizar;
