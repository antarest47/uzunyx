#!/usr/bin/python3
"""Uzunyx Doctor: updates the system and checks that Uzunyx still works.

Without arguments it does the whole routine, asking only when it has to:
checks, snapshot, simulated upgrade, upgrade, rebuild of the effects tied to
the KWin version, and a last round of checks after the next login.

  uzunyx-doctor                 the whole routine
  uzunyx-doctor --check         only the checks (no password, changes nothing)
  uzunyx-doctor --build         also build every package of the source tree
  uzunyx-doctor --after-login   the checks and questions after logging in
  uzunyx-doctor --login-hook    what the autostart entry runs
"""

import datetime
import glob
import json
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys

