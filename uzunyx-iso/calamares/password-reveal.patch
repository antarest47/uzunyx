+/* Uzunyx: an eye at the end of a password field that shows what's typed.
+ * The icons are the theme's (Kora's view-hidden is the open eye too; the
+ * crossed-out one is hint).
+ */
+static void
+uzunyxAddReveal( QLineEdit* field )
+{
+    QAction* reveal = field->addAction( QIcon::fromTheme( QStringLiteral( "view-visible" ) ),
+                                        QLineEdit::TrailingPosition );
+    reveal->setCheckable( true );
+    QObject::connect( reveal,
+                      &QAction::toggled,
+                      field,
+                      [ field, reveal ]( bool shown )
+                      {
+                          field->setEchoMode( shown ? QLineEdit::Normal : QLineEdit::Password );
+                          reveal->setIcon( QIcon::fromTheme( shown ? QStringLiteral( "hint" )
+                                                                   : QStringLiteral( "view-visible" ) ) );
+                      } );
+}
