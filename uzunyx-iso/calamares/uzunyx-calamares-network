#!/usr/bin/python3
"""The "Conexión" page of Calamares (uzunyx-network.qml) shows the network and
connects through this, with nmcli. Calamares can't run commands from QML, and
Plasma's executable data source crashed it, so uzunyx-calamares starts this
next to it and they talk through files, which plain QML reaches with
XMLHttpRequest (QML_XHR_ALLOW_FILE_READ/WRITE):

    $DIR/state.json     written here every 2 s: the devices, networks and the
                        answer to the last request
    $DIR/request.json   written by the page: {"id", "action": "connect" |
                        "wifi-on" | "rescan", "ssid", "password"}; read and
                        deleted here

DIR is /run/uzunyx-calamares-network (only root, as Calamares), or
$UZUNYX_NETWORK_DIR to try it out. Calamares runs as root, so a new Wi-Fi
connection is a system one, with its password, and networkcfg copies it to the
installed system.

    uzunyx-calamares-network serve
    uzunyx-calamares-network state
"""
import json
import os
import subprocess
import sys
import time

DIR = os.environ.get("UZUNYX_NETWORK_DIR", "/run/uzunyx-calamares-network")


def nmcli(*args):
    result = subprocess.run(["nmcli", "-t", *args], capture_output=True, text=True)
    return result.stdout.splitlines() if result.returncode == 0 else []


def fields(line):
    """nmcli -t separates with ":" and escapes it in values as "\\:"."""
    out, field, escaped = [], "", False
    for char in line:
        if escaped:
            field += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            out.append(field)
            field = ""
        else:
            field += char
    out.append(field)
    return out


def saved_ssids():
    ssids = set()
    for line in nmcli("-f", "NAME,TYPE", "connection", "show"):
        name, kind = fields(line)[:2]
        if kind == "802-11-wireless":
            ssid = nmcli("-g", "802-11-wireless.ssid", "connection", "show", name)
            ssids.add(ssid[0] if ssid else name)
    return ssids


def state(rescan=False):
    has_wifi, connected = False, None
    for line in nmcli("-f", "TYPE,STATE,CONNECTION", "device"):
        kind, status, name = fields(line)[:3]
        if kind == "wifi":
            has_wifi = True
        if kind in ("wifi", "ethernet") and status == "connected" and connected is None:
            connected = {"type": kind, "name": name}
    radio = nmcli("radio", "wifi")
    networks = {}
    if has_wifi:
        saved = saved_ssids()
        for line in nmcli("-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list",
                          "--rescan", "yes" if rescan else "no"):
            in_use, signal, security, ssid = fields(line)[:4]
            if not ssid:
                continue
            secure = security not in ("", "--")
            network = {"ssid": ssid, "signal": int(signal or 0), "secure": secure,
                       "security": security if secure else "",
                       "inUse": in_use == "*", "saved": ssid in saved}
            old = networks.get(ssid)
            if old is None or network["inUse"] or (not old["inUse"] and network["signal"] > old["signal"]):
                networks[ssid] = network
    connectivity = nmcli("networking", "connectivity")
    return {
        "wifi": has_wifi,
        "wifiOn": bool(radio) and radio[0] == "enabled",
        "connected": connected,
        "online": bool(connectivity) and connectivity[0] == "full",
        "networks": sorted(networks.values(), key=lambda n: (not n["inUse"], -n["signal"])),
    }


def connect(ssid, password):
    if ssid in saved_ssids() and not password:
        command = ["nmcli", "connection", "up", "id", ssid]
    else:
        command = ["nmcli", "device", "wifi", "connect", ssid]
        if password:
            command += ["password", password]
    ok = subprocess.run(command, capture_output=True, text=True).returncode == 0
    if not ok and password:
        # A wrong password leaves a connection behind that won't work.
        subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
    return ok


def write_state(data):
    path = os.path.join(DIR, "state.json")
    with open(path + ".tmp", "w") as out:
        json.dump(data, out)
    os.replace(path + ".tmp", path)


def serve():
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    request_path = os.path.join(DIR, "request.json")
    answer = None
    rescan = True
    while True:
        request = None
        if os.path.exists(request_path):
            try:
                with open(request_path) as source:
                    request = json.load(source)
            except (OSError, ValueError):
                pass
            os.remove(request_path)
        if request:
            action = request.get("action")
            ok = True
            if action == "connect":
                write_state({**state(), "busy": request.get("ssid", ""), "answer": answer})
                ok = connect(request.get("ssid", ""), request.get("password", ""))
            elif action == "wifi-on":
                subprocess.run(["nmcli", "radio", "wifi", "on"], capture_output=True)
                time.sleep(3)
                rescan = True
            elif action == "rescan":
                rescan = True
            answer = {"id": request.get("id"), "action": action, "ssid": request.get("ssid", ""), "ok": ok}
        write_state({**state(rescan), "busy": "", "answer": answer})
        rescan = False
        time.sleep(2)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "serve":
        serve()
    elif command == "state":
        print(json.dumps(state()))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
