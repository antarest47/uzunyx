#!/usr/bin/python3
"""The "Conexión" page of Calamares (uzunyx-network.qml) asks this for the state
of the network and connects with it, through nmcli. Calamares runs as root, so
a new Wi-Fi connection is a system one, with its password, and networkcfg copies
it to the installed system.

    uzunyx-calamares-network state [--rescan]   one line of JSON
    uzunyx-calamares-network connect SSID [PASSWORD]
    uzunyx-calamares-network wifi-on
"""
import json
import subprocess
import sys


def nmcli(*args):
    result = subprocess.run(["nmcli", "-t", *args], capture_output=True, text=True)
    return result.stdout.splitlines() if result.returncode == 0 else []


def fields(line):
    """nmcli -t separates with ":" and escapes it in values as "\\:"."""
    out, field, escaped = [], "", False
    for char in line:
        if escaped:
            field += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            out.append(field)
            field = ""
        else:
            field += char
    out.append(field)
    return out


def saved_ssids():
    ssids = set()
    for line in nmcli("-f", "NAME,TYPE", "connection", "show"):
        name, kind = fields(line)[:2]
        if kind == "802-11-wireless":
            ssid = nmcli("-g", "802-11-wireless.ssid", "connection", "show", name)
            ssids.add(ssid[0] if ssid else name)
    return ssids


def state(rescan):
    has_wifi, connected = False, None
    for line in nmcli("-f", "TYPE,STATE,CONNECTION", "device"):
        kind, status, name = fields(line)[:3]
        if kind == "wifi":
            has_wifi = True
        if kind in ("wifi", "ethernet") and status == "connected" and connected is None:
            connected = {"type": kind, "name": name}
    radio = nmcli("radio", "wifi")
    networks = {}
    if has_wifi:
        saved = saved_ssids()
        for line in nmcli("-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list",
                          "--rescan", "auto" if rescan else "no"):
            in_use, signal, security, ssid = fields(line)[:4]
            if not ssid:
                continue
            network = {"ssid": ssid, "signal": int(signal or 0), "secure": security not in ("", "--"),
                       "security": security if security not in ("", "--") else "",
                       "inUse": in_use == "*", "saved": ssid in saved}
            old = networks.get(ssid)
            if old is None or network["inUse"] or (not old["inUse"] and network["signal"] > old["signal"]):
                networks[ssid] = network
    connectivity = nmcli("networking", "connectivity")
    return {
        "wifi": has_wifi,
        "wifiOn": bool(radio) and radio[0] == "enabled",
        "connected": connected,
        "online": bool(connectivity) and connectivity[0] == "full",
        "networks": sorted(networks.values(), key=lambda n: (not n["inUse"], -n["signal"])),
    }


def connect(ssid, password):
    if ssid in saved_ssids() and not password:
        command = ["nmcli", "connection", "up", "id", ssid]
    else:
        command = ["nmcli", "device", "wifi", "connect", ssid]
        if password:
            command += ["password", password]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0 and password:
        # A wrong password leaves a connection behind that won't work.
        subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
    print(json.dumps({"connect": ssid, "ok": result.returncode == 0}))


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "state"
    if command == "state":
        print(json.dumps({"state": state("--rescan" in sys.argv)}))
    elif command == "connect" and len(sys.argv) >= 3:
        connect(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "")
    elif command == "wifi-on":
        subprocess.run(["nmcli", "radio", "wifi", "on"])
        print(json.dumps({"wifiOn": True}))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
