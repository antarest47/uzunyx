Depends: fonts-nunito, uzunyx-deco (>= 0.10.0), uzunyx-buttons (>= 0.8.0), uzunyx-plasmatheme (>= 0.6.0), uzunyx-wallpapers (>= 0.4.0), uzunyx-colors (>= 0.1.0), kora-icon-theme, qml6-module-qtquick-effects, plasma-workspace (>= 4:6.7)
